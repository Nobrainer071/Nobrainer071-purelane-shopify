{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .purelane-story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .purelane-story__image {
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .purelane-story__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .purelane-story__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .purelane-story__label {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .purelane-story__heading {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 300;
    line-height: 1.2;
  }

  .purelane-story__description {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .purelane-story__cta {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  @media screen and (max-width: 749px) {
    .purelane-story {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .purelane-story__content {
      gap: 1rem;
    }

    .purelane-story__heading {
      font-size: 1.75rem;
    }
  }

  {% if section.settings.layout == 'image_right' %}
    .purelane-story {
      direction: rtl;
    }

    .purelane-story > * {
      direction: ltr;
    }
  {% endif %}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="section-{{ section.id }}-padding page-width">
    <div class="purelane-story{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="purelane-story__image">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 400px, 100vw',
              widths: '375, 550, 750, 900'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="purelane-story__content">
        {%- if section.settings.label != blank -%}
          <p class="purelane-story__label">
            {{ section.settings.label }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="purelane-story__heading inline-richtext">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="purelane-story__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button purelane-story__cta{% if section.settings.button_style_secondary %} button--secondary{% endif %}"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane Brand Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Our Story"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Our Mission",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Learn More",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "Use secondary button style"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_left",
          "label": "Image left"
        },
        {
          "value": "image_right",
          "label": "Image right"
        }
      ],
      "default": "image_left",
      "label": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ]
}
{% endschema %}
