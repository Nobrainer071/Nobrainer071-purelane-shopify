{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .purelane-benefits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    grid-auto-rows: 1fr;
  }

  .purelane-benefits__item {
    display: flex;
    flex-direction: column;
    text-align: center;
    gap: 1.25rem;
  }

  .purelane-benefits__icon {
    width: 60px;
    height: 60px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
    font-size: 2rem;
  }

  .purelane-benefits__title {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .purelane-benefits__description {
    font-size: 0.95rem;
    opacity: 0.85;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .purelane-benefits {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .purelane-benefits__item {
      gap: 1rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="section-{{ section.id }}-padding page-width">
    <div class="title-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="rte subtitle">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    <div class="purelane-benefits">
      {%- for block in section.blocks -%}
        <div class="purelane-benefits__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="purelane-benefits__icon">
              {{ block.settings.icon }}
            </div>
          {%- endif -%}
          <h3 class="purelane-benefits__title">
            {{ block.settings.title }}
          </h3>
          <p class="purelane-benefits__description">
            {{ block.settings.description }}
          </p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane Benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Why Choose Purelane",
      "label": "Section heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "default": "✓",
          "label": "Icon or emoji"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Benefit title",
          "label": "Benefit title"
        },
        {
          "type": "textarea",
          "id": "description",
          "default": "Describe the benefit here",
          "label": "Benefit description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Pure Ingredients",
            "description": "Carefully selected natural and organic ingredients"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Cruelty-Free",
            "description": "Never tested on animals, always ethically sourced"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Sustainable",
            "description": "Eco-friendly packaging and carbon-neutral shipping"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✓",
            "title": "Results Driven",
            "description": "Clinically tested formulations that deliver visible results"
          }
        }
      ]
    }
  ]
}
{% endschema %}
